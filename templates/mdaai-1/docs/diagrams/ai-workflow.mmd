%% TEJL AI workflow for this repository template and downstream projects.
%% Edit this source file first, then run `just diagrams` to regenerate docs/assets/ai-workflow.svg.
%%{init: {"flowchart": {"htmlLabels": false}}}%%
flowchart TB
    U["Operator Request"] --> A["Nearest AGENTS.md<br/>Repository entry point"]
    A --> AD["Codex Adapter<br/>Provider-neutral rules"]
    AD --> T{"Request Type?"}

    T -->|"read-only"| R["Inspect relevant docs<br/>No Work Order required"]
    R --> OUT["Findings, proposal, or review"]

    T -->|"formal work"| INIT["Load MDAAI and task docs<br/>Resolve metadata from project files"]
    INIT --> WO["Create Work Order<br/>before file changes"]
    WO --> ARCH{"Architecture change?"}
    ARCH -->|"yes"| ADR["Consult or create ADR first"]
    ARCH -->|"no"| EXEC["Execute Work Order spec"]
    ADR --> EXEC

    EXEC --> VERIFY["Verify with Developer Guide commands"]
    VERIFY --> PASS{"Verification passed?"}
    PASS -->|"no"| CWO["Diagnostic or Corrective Work Order"]
    CWO --> EXEC

    PASS -->|"yes"| MEMORY["Update docs, diagrams, or knowledge<br/>Complete Work Order"]
    MEMORY --> REG["Record registry<br/>Function tools or registry.json"]
    REG --> CHK{"Checkpoint trigger?"}
    CHK -->|"yes"| CP["Checkpoint Protocol<br/>Immutable milestone record"]
    CHK -->|"no"| FINAL["Final report to Operator"]
    CP --> FINAL

    classDef entry fill:#f8fafc,stroke:#475569,stroke-width:2px,color:#0f172a
    classDef adapter fill:#eef2ff,stroke:#4f46e5,stroke-width:2px,color:#1e1b4b
    classDef read fill:#ecfdf5,stroke:#059669,stroke-width:2px,color:#064e3b
    classDef formal fill:#fff7ed,stroke:#ea580c,stroke-width:2px,color:#7c2d12
    classDef decision fill:#fefce8,stroke:#ca8a04,stroke-width:2px,color:#713f12
    classDef error fill:#fef2f2,stroke:#dc2626,stroke-width:2px,color:#7f1d1d
    classDef final fill:#f0f9ff,stroke:#0284c7,stroke-width:2px,color:#0c4a6e

    class U,A entry
    class AD adapter
    class R,OUT read
    class INIT,WO,ADR,EXEC,VERIFY,MEMORY,REG,CP formal
    class T,ARCH,PASS,CHK decision
    class CWO error
    class FINAL final
